# .env.example

# Flask
FLASK_DEBUG=1
FLASK_APP=app

# Secrets
SECRET_KEY="supersecret"
JWT_SECRET_KEY="supersecret_jwt_key"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant"


# Rate limiting
RATELIMIT_DEFAULT="5 per minute"

# Flask Caching
CACHE_TYPE="SimpleCache"
CACHE_DEFAULT_TIMEOUT=300